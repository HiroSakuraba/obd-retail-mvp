  "tests": [
    {
      "id": "warmup_curve",
      "kind": "obd_live",
      "question": "From a cold start, log coolant temperature (PID 05) over the first 10 minutes of driving. What does the curve show?",
      "reads": [
        "ECT_C",
        "RPM",
        "ELAPSED_S"
      ],
      "result_rules": [
        {
          "updates": {
            "coolant_temp_sensor": 0.6,
            "low_coolant": 0.8,
            "thermostat_stuck_open": 2.5
          },
          "when": "ect_after_10min_c < 70"
        },
        {
          "updates": {
            "coolant_temp_sensor": 3.0,
            "thermostat_stuck_open": 0.5
          },
          "when": "ect_after_10min_c >= 70 and ect_rise_c < 3"
        },
        {
          "updates": {
            "low_coolant": 2.0,
            "thermostat_stuck_open": 0.7
          },
          "when": "ect_after_10min_c >= 70 and ect_rise_c >= 3 and ect_fluctuates == 1"
        }
      ]
    },
    {
      "id": "coolant_level_check",
      "kind": "guided_visual",
      "question": "With the engine cold, is the coolant level in the reservoir clearly below the MIN mark, or are there visible leaks?",
      "updates_if_yes": {
        "low_coolant": 3.0,
        "thermostat_stuck_open": 0.8
      }
    }
  ],
