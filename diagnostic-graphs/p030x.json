  },
  "tests": [
    {
      "id": "mode06_misfire_counts",
      "kind": "obd_live",
      "question": "Read per-cylinder misfire counts (Mode 06). Which cylinder dominates?",
      "reads": [
        "MISFIRE_CYL1",
        "MISFIRE_CYL2",
        "MISFIRE_CYL3",
        "MISFIRE_CYL4"
      ],
      "result_rules": [
        {
          "updates": {
            "fuel_injector": 0.8,
            "ignition_coil": 1.6,
            "spark_plug": 1.5,
            "vacuum_leak": 0.6
          },
          "when": "dominant_share >= 0.7"
        },
        {
          "updates": {
            "ignition_coil": 0.6,
            "spark_plug": 0.6,
            "vacuum_leak": 2.2
          },
          "when": "dominant_share < 0.4"
        }
      ]
    },
    {
      "id": "coil_swap",
      "kind": "guided_manual",
      "question": "Swap the coil from the misfiring cylinder to a healthy one, clear codes, drive, and rescan. Did the misfire follow the coil to the new cylinder?",
      "updates_if_yes": {
        "ignition_coil": 4.0
      }
    },
    {
      "id": "plug_inspection",
      "kind": "guided_visual",
      "question": "Remove the plug from the misfiring cylinder. Is it fouled, oil-soaked, cracked, or is the gap far out of spec?",
      "updates_if_yes": {
        "spark_plug": 3.0
      }
    }
  ],
  "title": "Cylinder misfire detected"
